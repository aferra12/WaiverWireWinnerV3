# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
#   cp .env.example .env
#
# On Cloud Run these are set as service env vars / secrets instead; the real environment
# always wins over anything in .env.

# --- Required ------------------------------------------------------------------------

# Shared secret embedded in the email links. Any long random string:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FORM_TOKEN=

# Public URL of the service, used to build the links in the email.
# Locally this is http://localhost:8080
BASE_URL=http://localhost:8080

# Gmail account that sends the picks email, and a Google *app password*
# (16 characters, not your normal password). See the rotation steps in CLAUDE.md.
EMAIL_SENDER=waiverwirewinner@gmail.com
EMAIL_PASSWORD=

# --- Optional ------------------------------------------------------------------------

# Defaults to EMAIL_SENDER.
EMAIL_RECIPIENT=

# Max global roster percentage for the public posts list.
OWNERSHIP_THRESHOLD=7.5

# --- Your private ESPN league (for the "Available in your league" list) ----------------
# Without these the email still sends; the personal list is replaced with a note.
#
# To get the cookies: sign in at fantasy.espn.com, open DevTools -> Application ->
# Cookies -> https://fantasy.espn.com, and copy the two values below. They expire
# periodically and will need re-copying.
#
# Paste both exactly as ESPN shows them, with no surrounding quotes:
#
#   ESPN_SWID  keeps its curly braces, e.g. {A1B2C3D4-5E6F-7890-ABCD-EF1234567890}
#              (they are also added for you if you leave them off)
#   ESPN_S2    is one long URL-encoded string. Keep the %2B / %2F / %3D escapes as-is --
#              decoding it breaks authentication. It has no braces.

ESPN_LEAGUE_ID=760081598
ESPN_S2=
ESPN_SWID=
